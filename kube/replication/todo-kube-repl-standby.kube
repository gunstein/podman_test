[Unit]
Description=Todo isolated PostgreSQL Kube replication standby
StartLimitIntervalSec=60
StartLimitBurst=3

[Kube]
Yaml=standby.yaml
ConfigMap=standby-config-lab.yaml
Network=todo.network
PublishPort=127.0.0.1:15433:5432
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
