[Unit]
Description=Notes frontend and backend Podman Kube workload
Requires=notes-postgres.service keycloak.service
After=notes-postgres.service keycloak.service

[Kube]
Yaml=notes-app.yaml
ConfigMap=notes-config.yaml
Network=app-network.network
PodmanArgs=--no-pod-prefix
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
