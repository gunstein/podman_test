[Unit]
Description=Todo nginx Podman Kube candidate
Requires=todo-backend.service todo-keycloak.service
After=todo-backend.service todo-keycloak.service

[Kube]
Yaml=nginx.yaml
ConfigMap=config-lab.yaml
Network=todo.network
PublishPort=127.0.0.1:18080:8080
PublishPort=127.0.0.1:18443:8443
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120

[Install]
WantedBy=default.target
