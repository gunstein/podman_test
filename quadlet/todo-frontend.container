[Unit]
Description=Todo Caddy frontend and reverse proxy
Requires=todo-backend.service todo-keycloak.service
After=todo-backend.service todo-keycloak.service

[Container]
Image=localhost/todo-frontend:m11
ContainerName=todo-frontend
Network=todo.network
Volume=todo-caddy-data.volume:/data:U
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:8443:8443

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
