[Unit]
Description=Todo FastAPI backend Podman Kube candidate
Requires=todo-postgres.service
After=todo-postgres.service

[Kube]
Yaml=backend.yaml
ConfigMap=config-lab.yaml
Network=todo.network
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120

[Install]
WantedBy=default.target
