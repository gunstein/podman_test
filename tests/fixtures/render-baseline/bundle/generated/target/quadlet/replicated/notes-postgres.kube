[Unit]
Description=Notes PostgreSQL Podman Kube workload

[Kube]
Yaml=notes-postgres.yaml
ConfigMap=notes-config.yaml
Network=app-network.network
PublishPort=127.0.0.1:5433:5432
PublishPort=${TARGET_PUBLISH_ADDRESS}:5433:5432
PodmanArgs=--no-pod-prefix
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
ExecStartPost=/usr/bin/podman update --health-on-failure=kill notes-postgres
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=default.target
