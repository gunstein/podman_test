[Unit]
Description=Shared Nginx proxy for Kube workloads
Requires={{ app_services | join(' ') }} keycloak.service
After={{ app_services | join(' ') }} keycloak.service

[Kube]
Yaml=shared-proxy.yaml
Network=app-network.network
PodmanArgs=--no-pod-prefix
{# Always on loopback: plain HTTP 8080 for the host's own readiness checks and
   Keycloak administration, HTTPS 8443 for local use. The host address is
   added unless it is loopback itself (the bundle's local-only variant). #}
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:8443:8443
{% if publish_address != '127.0.0.1' %}
PublishPort={{ publish_address }}:{{ service_port }}:8443
{% endif %}
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
