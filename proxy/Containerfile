FROM docker.io/library/nginx:1.30.4-alpine
LABEL io.todo.proxy="nginx"
# The TLS modes proxy-entrypoint.sh knows; app_installer tls-install requires provided.
LABEL io.todo.proxy.tls="local provided"

RUN apk add --no-cache openssl \
    && mkdir -p /var/lib/platform-tls \
    && chown nginx:nginx /var/lib/platform-tls

COPY proxy/proxy-headers.conf /etc/nginx/platform-proxy-headers.conf
COPY --chmod=0755 proxy/proxy-entrypoint.sh /usr/local/bin/proxy-entrypoint

USER nginx
EXPOSE 8080 8443

ENTRYPOINT ["/usr/local/bin/proxy-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
