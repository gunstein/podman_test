[Unit]
Description=Shared Nginx proxy for Kube workloads
Requires={{ app_services | default(['todo-app.service']) | join(' ') }} keycloak.service
After={{ app_services | default(['todo-app.service']) | join(' ') }} keycloak.service

[Kube]
Yaml=shared-proxy.yaml
ConfigMap=config.yaml
Network=app-network.network
PodmanArgs=--no-pod-prefix
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:8443:8443
{% if todo_publish_address != '127.0.0.1' %}
PublishPort={{ todo_publish_address }}:{{ todo_service_port }}:8443
{% endif %}
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
