[Unit]
Description=Help app Podman Kube workload

[Kube]
Yaml=help-app.yaml
ConfigMap=help-config.yaml
Network=app-network.network
PodmanArgs=--no-pod-prefix
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
