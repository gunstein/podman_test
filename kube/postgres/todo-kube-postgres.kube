[Unit]
Description=Todo PostgreSQL Podman Kube persistence candidate

[Kube]
Yaml=postgres.yaml
ConfigMap=config-lab.yaml
Network=todo.network
PublishPort=127.0.0.1:15432:5432
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
