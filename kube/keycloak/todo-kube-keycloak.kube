[Unit]
Description=Todo Keycloak Podman Kube candidate
Requires=todo-postgres.service
After=todo-postgres.service

[Kube]
Yaml=keycloak.yaml
ConfigMap=config-lab.yaml
Network=todo.network
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=240
TimeoutStopSec=60

[Install]
WantedBy=default.target
