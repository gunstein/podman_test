[Unit]
Description=Todo PostgreSQL Podman Kube workload

[Kube]
Yaml=postgres.yaml
ConfigMap=config.yaml
Network=app-network.network
PublishPort=127.0.0.1:{{ postgres_publish_port | default(5432) }}:5432
{% if postgres_publish_address | default('') | length > 0 %}
PublishPort={{ postgres_publish_address }}:{{ postgres_publish_port | default(5432) }}:5432
{% endif %}
PodmanArgs=--no-pod-prefix
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
ExecStartPost=/usr/bin/podman update --health-on-failure=kill todo-postgres
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=default.target
