# The nightly renewal of the replication TLS certificates. On the primary it
# issues a new certificate for every database whose certificate has fewer
# than 30 days left, and PostgreSQL reloads it without a restart; on a
# standby it does nothing. A failure fails the unit, so it shows in
# `systemctl --user --failed`, and `app_dr.py check` fails too once a
# certificate has fewer than 25 days left:
#   journalctl --user -u platform-replication-tls.service
# app-ops install-dr-tool installs it on both hosts with platform-replication-tls.timer.
[Unit]
Description=Todo replication TLS certificate renewal

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/platform/bin/app_dr.py renew-tls
TimeoutStartSec=10min
