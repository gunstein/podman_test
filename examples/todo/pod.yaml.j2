{# This app's pod (docs/PLATFORM-PLAN.md, section 5.9): its migration init
   container, backend and frontend. The platform renders it with app (the
   App: app.pod, app.names, app.database) and images ({name: reference} of
   the images app.yaml declares), then checks it (pod_contract.py): the pod
   and its containers named after the app, only declared images, only its own
   secrets, no host access or added capabilities, memory limits, and a
   container port for each endpoint. Notes has the same file. #}
apiVersion: v1
kind: Pod
metadata:
  name: {{ app.pod | tojson }}
  labels:
    app.kubernetes.io/name: {{ app.name | tojson }}
    app.kubernetes.io/component: application
  annotations:
    io.podman.annotations.pids-limit/{{ app.names.resource("migrate") }}: "128"
    io.podman.annotations.pids-limit/{{ app.names.resource("backend") }}: "128"
    io.podman.annotations.pids-limit/{{ app.names.resource("frontend") }}: "128"
spec:
{# systemd restarts the unit, never Podman a single container. #}
  restartPolicy: Never
{# Migrations run as the migrator role before the backend starts; a failed
   migration stops the pod from starting. #}
  initContainers:
    - name: {{ app.names.resource("migrate") | tojson }}
      image: {{ images.backend | tojson }}
      imagePullPolicy: Never
      args: [python, -m, backend.migrate, --connect-timeout, "120", up]
      envFrom:
        - configMapRef:
            name: {{ app.names.resource("backend-config") | tojson }}
            optional: false
      env:
        - name: DATABASE_USER
          value: {{ app.database.role("migrator") | tojson }}
        - name: DATABASE_PASSWORD_FILE
          value: {{ ("/run/secrets/" + app.names.resource("migrator") + "/database-password") | tojson }}
      volumeMounts:
        - name: migrator-secret
          mountPath: {{ ("/run/secrets/" + app.names.resource("migrator")) | tojson }}
          readOnly: true
      resources:
        limits:
          memory: "256Mi"
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        allowPrivilegeEscalation: false
        capabilities:
          drop: [ALL]
  containers:
    - name: {{ app.names.resource("backend") | tojson }}
      image: {{ images.backend | tojson }}
      imagePullPolicy: Never
      ports:
        - name: backend-http
          containerPort: 8000
      envFrom:
        - configMapRef:
            name: {{ app.names.resource("backend-config") | tojson }}
            optional: false
      env:
        - name: DATABASE_USER
          value: {{ app.database.role("app") | tojson }}
        - name: DATABASE_PASSWORD_FILE
          value: {{ ("/run/secrets/" + app.names.resource("backend") + "/database-password") | tojson }}
      volumeMounts:
        - name: backend-secret
          mountPath: {{ ("/run/secrets/" + app.names.resource("backend")) | tojson }}
          readOnly: true
      livenessProbe:
        exec:
          command:
            - python
            - -c
            - >-
              import socket;
              socket.create_connection(("127.0.0.1", 8000), 1).close()
        initialDelaySeconds: 2
        periodSeconds: 10
        timeoutSeconds: 2
        failureThreshold: 3
      resources:
        limits:
          memory: "256Mi"
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        allowPrivilegeEscalation: false
        capabilities:
          drop: [ALL]

    - name: {{ app.names.resource("frontend") | tojson }}
      image: {{ images.frontend | tojson }}
      imagePullPolicy: Never
      ports:
        - name: frontend-http
          containerPort: 8080
      resources:
        limits:
          memory: "128Mi"
      securityContext:
        runAsUser: 101
        runAsGroup: 101
        allowPrivilegeEscalation: false
        capabilities:
          drop: [ALL]
  volumes:
    - name: backend-secret
      secret:
        secretName: {{ app.names.kube_secret("backend") | tojson }}
        optional: false
        defaultMode: 0444
    - name: migrator-secret
      secret:
        secretName: {{ app.names.kube_secret("migrator") | tojson }}
        optional: false
        defaultMode: 0444
