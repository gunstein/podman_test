FROM docker.io/library/nginx:1.30.4-alpine
LABEL io.todo.frontend="nginx"

COPY frontend/nginx.conf /etc/nginx/nginx.conf
COPY frontend/index.html /usr/share/nginx/html/index.html
COPY frontend/app.js /usr/share/nginx/html/app.js
COPY frontend/auth.js frontend/keycloak-adapter.js /usr/share/nginx/html/
COPY frontend/style.css /usr/share/nginx/html/style.css
COPY frontend/vendor /usr/share/nginx/html/vendor

USER nginx
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
