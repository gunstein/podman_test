[Unit]
Description=Shared Nginx proxy for Kube workloads
Requires=todo-app.service notes-app.service keycloak.service
After=todo-app.service notes-app.service keycloak.service

[Kube]
Yaml=shared-proxy.yaml
Network=app-network.network
PodmanArgs=--no-pod-prefix
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:8443:8443
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
