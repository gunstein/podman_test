{# Keycloak's unit (apps.KEYCLOAK_WORKLOAD); it requires its own database.
   No [Install] section: Keycloak starts because the app units require it,
   so a database-only standby, which has no app units, never starts it. #}
[Unit]
Description=Shared Keycloak Podman Kube workload
Requires={{ workload.requires | join(' ') }}
After={{ workload.requires | join(' ') }}

[Kube]
Yaml={{ workload.yaml }}
Network=app-network.network
PodmanArgs=--no-pod-prefix
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=240
TimeoutStopSec=60
