worker_processes auto;
error_log /dev/stderr notice;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /dev/stdout main;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    sendfile on;
    keepalive_timeout 65;
    server_tokens off;

    upstream todo_backend {
        server todo-backend:8000;
    }

    upstream todo_keycloak {
        server todo-keycloak:8080;
    }

    server {
        listen 8080;
        listen {{ m14_service_port }} ssl;
        server_name {{ m14_service_hostname }};

        ssl_certificate /var/lib/todo-tls/server.crt;
        ssl_certificate_key /var/lib/todo-tls/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;

        root /usr/share/nginx/html;
        index index.html;

        add_header X-Content-Type-Options nosniff always;

        location /auth/ {
            proxy_pass http://todo_keycloak;
            include /etc/nginx/todo-proxy-headers.conf;
        }

        location /api/ {
            proxy_pass http://todo_backend;
            include /etc/nginx/todo-proxy-headers.conf;
        }

        location = /health {
            proxy_pass http://todo_backend;
            include /etc/nginx/todo-proxy-headers.conf;
        }

        location = /ready {
            proxy_pass http://todo_backend;
            include /etc/nginx/todo-proxy-headers.conf;
        }

        location / {
            try_files $uri /index.html;
        }
    }
}
