{%- set pod = database.resource("postgres") -%}
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ database.volume("data") | tojson }}
  annotations:
    volume.podman.io/uid: "999"
    volume.podman.io/gid: "999"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ database.volume("backup") | tojson }}
  annotations:
    volume.podman.io/uid: "999"
    volume.podman.io/gid: "999"
---
apiVersion: v1
kind: Pod
metadata:
  name: {{ pod | tojson }}
  labels:
    app.kubernetes.io/name: {{ database.name | tojson }}
    app.kubernetes.io/component: database
  annotations:
    io.podman.annotations.pids-limit/{{ pod }}: "256"
spec:
  restartPolicy: Never
  terminationGracePeriodSeconds: 60
  containers:
    - name: {{ pod | tojson }}
      image: {{ image | tojson }}
      imagePullPolicy: Never
      args:
        - postgres
        - -D
        - /var/lib/postgresql/data
        - -c
        - "max_slot_wal_keep_size=1GB"
      ports:
        - name: postgres
          containerPort: 5432
      envFrom:
        - configMapRef:
            name: {{ database.resource("postgres-config") | tojson }}
            optional: false
      env:
        - name: POSTGRES_PASSWORD_FILE
          value: {{ ("/run/secrets/" + pod + "/database-password") | tojson }}
      volumeMounts:
        - name: postgres-data
          mountPath: /var/lib/postgresql/data
        - name: postgres-backup
          mountPath: /var/lib/postgresql/backup
        - name: postgres-secret
          mountPath: {{ ("/run/secrets/" + pod) | tojson }}
          readOnly: true
      livenessProbe:
        exec:
          command: [pg_isready, --username, {{ database.name | tojson }}, --dbname, {{ database.name | tojson }}]
        initialDelaySeconds: 5
        periodSeconds: 10
        timeoutSeconds: 5
        failureThreshold: 5
      resources:
        limits:
          memory: "512Mi"
      securityContext:
        runAsUser: 999
        runAsGroup: 999
        allowPrivilegeEscalation: false
        capabilities:
          drop: [ALL]
  volumes:
    - name: postgres-data
      persistentVolumeClaim:
        claimName: {{ database.volume("data") | tojson }}
    - name: postgres-backup
      persistentVolumeClaim:
        claimName: {{ database.volume("backup") | tojson }}
    - name: postgres-secret
      secret:
        secretName: {{ database.kube_secret("postgres") | tojson }}
        optional: false
        defaultMode: 0444
