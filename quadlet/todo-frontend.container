[Unit]
Description=Todo nginx frontend and reverse proxy
Requires=todo-backend.service todo-keycloak.service
After=todo-backend.service todo-keycloak.service

[Container]
Image=localhost/todo-frontend:m12
ContainerName=todo-frontend
Network=todo.network
Volume=todo-nginx-data.volume:/var/lib/todo-tls:U
Environment=TODO_TLS_HOSTNAME=localhost
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:8443:8443
NoNewPrivileges=true
DropCapability=all
PidsLimit=128

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
