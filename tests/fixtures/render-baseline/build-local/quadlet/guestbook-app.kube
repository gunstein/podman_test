[Unit]
Description=Guestbook app Podman Kube workload
Requires=guestbook-postgres.service keycloak.service
After=guestbook-postgres.service keycloak.service

[Kube]
Yaml=guestbook-app.yaml
ConfigMap=guestbook-config.yaml
Network=app-network.network
PodmanArgs=--no-pod-prefix
ExitCodePropagation=any
LogDriver=journald
SetWorkingDirectory=yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
