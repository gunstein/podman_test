{
  "format": "platform-offline-bundle",
  "format_version": 12,
  "manifests": {
    "directory": "generated/target/manifests",
    "files": [
      "help-app.yaml",
      "help-config.yaml",
      "keycloak-config.yaml",
      "keycloak-postgres.yaml",
      "keycloak.yaml",
      "notes-app.yaml",
      "notes-config.yaml",
      "notes-postgres.yaml",
      "shared-proxy.yaml",
      "todo-app.yaml",
      "todo-config.yaml",
      "todo-postgres.yaml"
    ]
  },
  "quadlets": {
    "directory": "generated/target/quadlet",
    "files": [
      "help-app.kube",
      "keycloak-postgres.kube",
      "keycloak.kube",
      "notes-app.kube",
      "notes-postgres.kube",
      "shared-proxy.kube",
      "todo-app.kube",
      "todo-postgres.kube"
    ]
  },
  "local_only_quadlets": {
    "directory": "generated/target/quadlet/local-only",
    "files": [
      "shared-proxy.kube"
    ]
  },
  "replicated_quadlets": {
    "directory": "generated/target/quadlet/replicated",
    "files": [
      "keycloak-postgres.kube",
      "notes-postgres.kube",
      "todo-postgres.kube"
    ]
  },
  "network": "generated/target/quadlet/app-network.network",
  "platform": {
    "identity_hostname": "auth.test",
    "apps": [
      {
        "name": "todo",
        "hostname": "todo.test",
        "keycloak_client": "todo-frontend",
        "has_database": true,
        "replication_port": 5432,
        "images": [
          {
            "name": "backend",
            "context": ".",
            "containerfile": "todo-backend/Containerfile"
          },
          {
            "name": "frontend",
            "context": ".",
            "containerfile": "todo-frontend/Containerfile"
          }
        ],
        "endpoints": [
          {
            "name": "frontend",
            "port": 8080
          },
          {
            "name": "backend",
            "port": 8000
          }
        ],
        "routes": [
          {
            "path": "/api/",
            "to": "backend",
            "exact": false
          },
          {
            "path": "/health",
            "to": "backend",
            "exact": true
          },
          {
            "path": "/ready",
            "to": "backend",
            "exact": true
          },
          {
            "path": "/",
            "to": "frontend",
            "exact": false
          }
        ],
        "ready": "/ready",
        "pod_template": "examples/todo/pod.yaml.j2",
        "containers": [
          "todo-backend",
          "todo-frontend"
        ],
        "checks": [
          {
            "path": "/health",
            "status": 200
          },
          {
            "path": "/api/todos",
            "status": 200
          }
        ]
      },
      {
        "name": "notes",
        "hostname": "notes.test",
        "keycloak_client": "notes-frontend",
        "has_database": true,
        "replication_port": 5433,
        "images": [
          {
            "name": "backend",
            "context": ".",
            "containerfile": "notes-backend/Containerfile"
          },
          {
            "name": "frontend",
            "context": ".",
            "containerfile": "notes-frontend/Containerfile"
          }
        ],
        "endpoints": [
          {
            "name": "frontend",
            "port": 8080
          },
          {
            "name": "backend",
            "port": 8000
          }
        ],
        "routes": [
          {
            "path": "/api/",
            "to": "backend",
            "exact": false
          },
          {
            "path": "/health",
            "to": "backend",
            "exact": true
          },
          {
            "path": "/ready",
            "to": "backend",
            "exact": true
          },
          {
            "path": "/",
            "to": "frontend",
            "exact": false
          }
        ],
        "ready": "/ready",
        "pod_template": "examples/notes/pod.yaml.j2",
        "containers": [
          "notes-backend",
          "notes-frontend"
        ],
        "checks": [
          {
            "path": "/health",
            "status": 200
          },
          {
            "path": "/api/notes",
            "status": 200
          }
        ]
      },
      {
        "name": "help",
        "hostname": "help.test",
        "keycloak_client": "",
        "has_database": false,
        "replication_port": 0,
        "images": [
          {
            "name": "site",
            "context": "examples/help",
            "containerfile": "Containerfile"
          }
        ],
        "endpoints": [
          {
            "name": "site",
            "port": 8080
          }
        ],
        "routes": [
          {
            "path": "/",
            "to": "site",
            "exact": false
          }
        ],
        "ready": "/",
        "pod_template": "examples/help/pod.yaml.j2",
        "containers": [
          "help-site"
        ],
        "checks": [
          {
            "path": "/",
            "status": 200
          }
        ]
      }
    ]
  },
  "public_port": 8443,
  "defaults": {
    "TARGET_IDENTITY_HOSTNAME": "auth.test",
    "TARGET_TODO_HOSTNAME": "todo.test",
    "TARGET_NOTES_HOSTNAME": "notes.test",
    "TARGET_HELP_HOSTNAME": "help.test"
  }
}
